ANTHROPIC_API_KEY=your_key_here

# Complimentary textbook access — comma-separated emails that bypass payment
# and see every published textbook as already purchased. ADMIN_EMAILS get
# this automatically. Set to empty / unset to disable.
COMP_TEXTBOOK_EMAILS=

# Cloudflare R2
CLOUDFLARE_R2_BUCKET=novaiq-materials
CLOUDFLARE_R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_PUBLIC_URL=https://pub-<hash>.r2.dev

# NICEPAY primary checkout for Korea
NEXT_PUBLIC_NICEPAY_ENABLED=true
NEXT_PUBLIC_NICEPAY_CLIENT_ID=
NICEPAY_CLIENT_ID=
NICEPAY_SECRET_KEY=
NICEPAY_CURRENCY=KRW
NICEPAY_METHOD=card
NICEPAY_API_BASE_URL=https://api.nicepay.co.kr
NICEPAY_BILLING_KEY_SECRET=
NICEPAY_BILLING_PERIOD_DAYS=30
NICEPAY_ALLOW_DIRECT_BILLING_KEY_STORE=false

# Merchant disclosure for footer/legal pages
NEXT_PUBLIC_MERCHANT_NAME=InHero
NEXT_PUBLIC_MERCHANT_REPRESENTATIVE=
NEXT_PUBLIC_MERCHANT_REGISTRATION_NUMBER=
NEXT_PUBLIC_ECOMMERCE_REGISTRATION_NUMBER=
NEXT_PUBLIC_MERCHANT_ADDRESS=
NEXT_PUBLIC_MERCHANT_PHONE=
NEXT_PUBLIC_MERCHANT_EMAIL=inheroedu@gmail.com

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Vercel preview deploys for Trajectory Lab
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
VERCEL_GIT_SOURCE_TYPE=github
VERCEL_GIT_SOURCE_REPO_ID=
VERCEL_GIT_SOURCE_REF=main
