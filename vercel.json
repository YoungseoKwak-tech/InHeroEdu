{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install --legacy-peer-deps",
  "framework": "nextjs",
  "regions": ["icn1"],
  "functions": {
    "app/api/generate-textbook/route.ts": {
      "maxDuration": 10
    },
    "app/api/generate-textbook-worker/route.ts": {
      "maxDuration": 300
    },
    "app/api/generate-textbook-content/route.ts": {
      "maxDuration": 300
    },
    "app/api/generate-textbook-docx/route.ts": {
      "maxDuration": 60
    },
    "app/api/generate-textbook-save/route.ts": {
      "maxDuration": 60
    },
    "app/api/admin/generate-script-sync/route.ts": {
      "maxDuration": 300
    },
    "app/api/library/resource/[id]/process-preview/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/process-attention-rollups/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/process-nicepay-billing/route.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/process-attention-rollups",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/cleanup-deleted-resources",
      "schedule": "0 3 * * *"
    }
  ]
}
